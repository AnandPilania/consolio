{
    "name": "@pilaniaanand/consolio",
    "version": "0.3.2",
    "description": "Lightweight, project-isolated API testing tool — a fast Postman alternative",
    "keywords": [
        "api",
        "rest",
        "testing",
        "postman-alternative",
        "http-client",
        "developer-tools"
    ],
    "author": {
        "name": "Anand Pilania",
        "email": "pilaniaanand@gmail.com",
        "url": "https://github.com/AnandPilania"
    },
    "license": "MIT",
    "bin": {
        "consolio": "./bin/consolio.js"
    },
    "files": [
        "bin",
        "server",
        "dist",
        "extension",
        "README.md"
    ],
    "type": "module",
    "main": "./server/index.js",
    "scripts": {
        "start": "node bin/consolio.js",
        "dev": "concurrently --kill-others-on-fail -n api,ui -c cyan,yellow \"cross-env CONSOLIO_DEV=true node bin/consolio.js --no-open\" \"vite\"",
        "build": "vite build",
        "preview": "node bin/consolio.js",
        "prepack": "vite build"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/static": "^9.1.0",
        "chalk": "^5.6.2",
        "commander": "^14.0.3",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "fastify": "^5.8.4",
        "node-fetch": "^3.3.2",
        "open": "^11.0.0",
        "ws": "^8.20.0"
    },
    "devDependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@vitejs/plugin-react": "^6.0.1",
        "clsx": "^2.1.1",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-resizable-panels": "^3.0.6",
        "vite": "^8.0.8",
        "zustand": "^5.0.12"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
